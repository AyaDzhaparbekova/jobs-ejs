<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<div class="container mt-5 text-center">

  <h2 class="mb-4">Secret Word Page</h2>

  <p class="fs-5">
    The secret word is:
    <strong class="text-warning"><%= secretWord %></strong>
  </p>

  <p class="mt-4">Would you like to change it?</p>

  <form method="POST" action="/secretWord" class="mt-3">
    
    <div class="mb-3">
      <label class="form-label">New Secret Word</label>
      <input 
        type="text"
        name="secretWord"
        class="form-control"
        required
      />
    </div>

    <button class="btn btn-primary px-4">
      Submit
    </button>

  </form>

</div>

<%- include("partials/footer.ejs") %>